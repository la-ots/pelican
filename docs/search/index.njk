---
layout: default.njk
title: Search
description: Find guidance and patterns across Pelican.
eleventyExcludeFromCollections: true
---

<section class="section page-content" data-pagefind-body>
  <div class="container">
    <h1 class="mt-6 mt-lg-0">{{ title }}</h1>
    {% if description %}
    <p>{{ description }}</p>
    {% endif %}
    <form action="/search/" role="search" method="GET" data-site-search>
      <div class="form-group mb-4">
        <label for="pelicanSearchTerms" class="form-label">
          Search this site
        </label>
        <div class="input-group">
          <input type="search"
            class="form-control"
            id="pelicanSearchTerms"
            name="q">
          <button class="btn btn-outline-ui"
            type="submit"
            id="pelicanSearchButton">
            <span class="icon fas fa-search" aria-hidden="true"></span>
            Search
          </button>
        </div>
      </div>
    </form>
    <div id="pelicanSearchWrapper" aria-live="polite" aria-busy="false">
      <div id="pelicanSearchSummary"></div>
      <div id="pelicanSearchResultsList"></div>
      <div id="pelicanSearchPagination"></div>
    </div>
  </div>
</section>
