---
layout: default.njk
title: Search
description: Find guidance and patterns across Pelican.
summary: Find guidance and patterns across Pelican.
eleventyExcludeFromCollections: true
---
<!-- let’s use frontmatter closer to other pages -->

{% include "page-title.njk" %}

<section class="content-container content-area" aria-label="Page Content" data-pagefind-body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <h2 tabinex="-1">Results</h2>
      </div>
    </div>
    <div class="row">
      <div class="col-12 col-lg-6">
        <div aria-busy="false">
          <div id="pelicanSearchWrapper"  aria-busy="false">
            <form action="/search/" role="search" method="GET" aria-label="Site search" data-site-search>
              <div class="form-group mb-3">
                <label for="pelicanSearchTerms" class="visually-hidden">
                  Search this site
                </label>
                <div class="input-group search-results-search">
                  <!-- this could be replaced with a Bootstrap column class -->
                  <input
                    type="search"
                    class="form-control"
                    id="pelicanSearchTerms"
                    name="q"
                  >
                  <button
                    class="btn btn-outline-ui"
                    type="submit"
                    id="pelicanSearchButton"
                  >
                    <span class="icon fas fa-search" aria-hidden="true"></span>
                    Search
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-12">
          <hr class="minor" />
        </div>
      </div>
      <div class="row">
        <div class="col-12">
          <div
              id="pelicanSearchSummary"
              class="search-results-summary"
              role="status"
              aria-live="polite"
              aria-atomic="true"
            ></div>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-12">
          <!-- we could use the card component from Pelican as the card items in here -->
          <div id="pelicanSearchResultsList" class="search-results-list"></div>
        </div>
      </div>
      <div class="row">
        <div class="col-12">
          <!-- this could be replaced with the Pelican pagination component -->
          <div id="pelicanSearchPagination" class="search-results-pagination"></div>
        </div>
      </div>
    </div>
  </div>
</section>
