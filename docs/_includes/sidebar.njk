<nav id="sidebar" class="sidebar-wrapper" aria-label="sidebar">
    <div class="sidebar-content">
      <div class="sidebar-brand">
        <a href="{{ '/' | url }}" class="me-auto" tabindex="4">
          <span class="d-md-none">Pelican Design System</span>
          <img src="/img/favicon.png" class="d-none d-md-inline" alt="Pelican Design System icon" />
          <span class="d-none d-md-inline">Pelican <span class="visually-hidden">Home</span></span>
        </a>
      </div>
      {% include 'markup/sidebar-search.njk' %}
      <div class="sidebar-menu text-white">
        {% set navPages = collections.all | eleventyNavigation %}
        <ul>
        {%- for entry in navPages %}
          {% set isEntryCurrent = entry.url == page.url %}
          <li class="sidebar-item">
            <div class="sidebar-dropdown-header">
              <a class="sidebar-nav-item{% if isEntryCurrent %} active{% endif %}" href="{{ entry.url | url }}" data-search-excerpt="{{ (entry.excerpt or '') | escape }}"{% if isEntryCurrent %} aria-current="page"{% endif %}>
                {% if isEntryCurrent %}
                  <span class="icon fas fa-fw fa-eye me-1" aria-hidden="true"></span>
                {% endif %}
                <span>{{ entry.title }}</span>
              </a>              
              {% if entry.children.length > 0 %}
                <button class="sidebar-dropdown-header-expand{% if entry.url in page.url %} active {% endif %}" type="button" aria-expanded="false" aria-controls="{{ entry.title | lower | replace(" ", "-") | replace(",", "") | replace(".", "") }}">
                  <span class="visually-hidden">
                    Get guidance for items in {{ entry.title }}
                  </span>
                  <span class="icon fas fa-fw fa-angle-right" aria-hidden="true"></span>
                </button>
              {% endif %}
            </div>
            {% if entry.children.length > 0 %}
            <div class="sidebar-submenu" {% if entry.url in page.url %} style="display:block" {% endif %} id="{{ entry.title | lower | replace(" ", "-") | replace(",", "") | replace(".", "") }}">
              <ul>
                {% for child in entry.children %}
                  {% set isChildCurrent = child.url == page.url %}
                  <li {% if isChildCurrent %} class="sidebar-item active" {% else %} class="sidebar-item" {% endif %}>
                    <a {% if isChildCurrent %} class="sidebar-nav-item active" {% else %} class="sidebar-nav-item" {% endif %} href="{{ child.url | url }}" data-search-excerpt="{{ (child.excerpt or '') | escape }}"{% if isChildCurrent %} aria-current="page"{% endif %}>
                      <span {% if isChildCurrent %} class="icon fas fa-fw fa-eye me-1" {% else %} class="icon fas fa-fw fa-eye invisible me-1" {% endif %} aria-hidden="true"></span><span>{{ child.title }}</span>
                    </a>
                  </li>
                {% endfor %}                
              </ul>
            </div>
            {% endif %}
          </li>
        {%- endfor %}
        </ul>
      </div>
    </div>
  </nav>
  