<div class="row mb-4">
	<div class="col-12">
		<div class="d-flex align-items-center">
			<div class="status-wrapper">
				{%- if pelican == true %}
				<span class="status status-info me-1">
					<span class="icon fas fa-info-circle" aria-hidden="true"></span>
					<span class="status-message">Pelican 2 Custom Component</span>
				</span>
				{%- elif pelican is undefined %}
				<span class="status status-info me-1">
					<span class="icon fas fa-info-circle" aria-hidden="true"></span>
					<span class="status-message">Bootstrap Component</span>
				</span>
				{%- endif %}
			</div>
			<p class="mb-0 ms-2">Refer to <a href="http://localhost:8080/foundation/bootstrap-pelican/">Bootstrap or Pelican?</a> for more information.</p>
		</div>
	</div>
</div>
