<div class="sidebar-search">
  <div>
    <form action="/search/" method="GET" role="search" aria-label="Site search" data-site-search>
      <div class="form-group mb-0 position-relative">
        <label for="sidebar-site-search" class="visually-hidden">Site search</label>
        <input type="search" name="q" class="form-control pe-5 sidebar-site-search-input" id="sidebar-site-search">
        <button type="submit" class="btn shadow-none btn-sm position-absolute top-50 end-0 translate-middle-y" aria-label="Search">
          <span class="visually-hidden">Search</span>
          <span class="icon fas fa-search" aria-hidden="true"></span>
        </button>
      </div>
    </form>
  </div>
</div>
